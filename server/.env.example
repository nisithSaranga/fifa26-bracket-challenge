# Copy this file to .env and fill in real values. NEVER commit .env to git.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fifa26

# Generate two DIFFERENT random secrets, e.g. run:  openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# Free key from https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# Where the Next.js frontend will run
CLIENT_ORIGIN=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
